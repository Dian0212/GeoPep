# =============================================================================
# GeoPep Configuration File - TEMPLATE
# =============================================================================
# Copy this file to config.yaml and fill in your HuggingFace token.
#
# All paths below are interpreted as RELATIVE TO THE PROJECT ROOT (the parent
# directory of this configs/ folder). Absolute paths are also accepted.
# CLI flags on train_pipeline.py / inference_pipeline.py override the relevant
# fields at runtime.
# =============================================================================

# -----------------------------------------------------------------------------
# Preprocessing Settings (PDB -> JSON)
# -----------------------------------------------------------------------------
preprocess:
  # Naming: <PDBID>_<peptide_chain>_<protein_chain>.pdb (e.g. 1abc_A_B.pdb)
  complex_directory: "pdb/complex"

  # Interface-only PDB files (same filenames as complex/). Leave blank or set
  # to a non-existent path to run preprocess in inference-only mode (skips
  # interface labels and distance maps).
  interface_directory: "pdb/interface"

  output_directory: "json/preprocessed"
  num_json_files: 5

# -----------------------------------------------------------------------------
# Data Settings (used by training)
# -----------------------------------------------------------------------------
data:
  train_json:
    - "json/preprocessed/data_part_1.json"
    - "json/preprocessed/data_part_2.json"
    - "json/preprocessed/data_part_3.json"
  val_json:
    - "json/preprocessed/data_part_4.json"

# -----------------------------------------------------------------------------
# Model Settings (don't change — these define the architecture)
# -----------------------------------------------------------------------------
model:
  peptide_len: 50
  protein_len: 500
  num_label_types: 3   # 0=non-interface, 1=interface, 2=padding

# -----------------------------------------------------------------------------
# Training Settings
# -----------------------------------------------------------------------------
training:
  batch_size: 4
  learning_rate: 0.0001
  max_epochs: 100
  use_distance_loss: true

  # Where trained checkpoints land. CLI --output-dir on train_pipeline.py overrides this.
  checkpoint_dir: "model_weights"

  # Optional knobs (defaults are usually fine):
  # checkpoint_filename: "model-{epoch:02d}"
  # save_top_k: 1
  # num_workers: 4

# -----------------------------------------------------------------------------
# Prediction Settings (used by predict_esm3.py when run standalone)
# -----------------------------------------------------------------------------
prediction:
  checkpoint_path: "model_weights/model_distanceLoss.ckpt"
  input_json: "json/preprocessed/data_part_5.json"
  input_field: "combined_chains"
  device: "cuda"

# -----------------------------------------------------------------------------
# Hardware Settings
# -----------------------------------------------------------------------------
hardware:
  gpus: [0]      # list of GPU device ids; e.g. [0, 1, 2, 3] for 4 GPUs
  precision: 16  # 16 (mixed precision) or 32

# -----------------------------------------------------------------------------
# HuggingFace Settings
# -----------------------------------------------------------------------------
huggingface:
  # ESM3 is gated. Get a token at https://huggingface.co/settings/tokens and
  # accept the model TOS at https://huggingface.co/EvolutionaryScale/esm3-sm-open-v1
  #
  # You can leave the placeholder below; the scripts will fall back to:
  #   1. the HF_TOKEN environment variable, then
  #   2. an interactive prompt at runtime
  # IMPORTANT: never commit a real token. config.yaml is gitignored for this
  # reason -- only this template is tracked.
  token: "hf_your_token_here"
